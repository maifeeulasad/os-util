{
  "name": "os-util",
  "version": "0.0.0",
  "description": "OS utility tools collection - Network speed monitor and more system utilities",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "os-util": "dist/cli.js",
    "os-util-tray": "dist/tray/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "tray": "node dist/tray/index.js",
    "icon": "node scripts/generate-tray-icon.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "pnpm run clean"
  },
  "keywords": [
    "network",
    "speed",
    "monitor",
    "bandwidth",
    "cli",
    "typescript"
  ],
  "author": "Network Speed Monitor",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "systray2": "^2.1.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}